# Optional account and cloud-save service. Guest play/local saves do not require it.
VITE_ACCOUNT_SERVER_URL=http://localhost:8082

# Account server settings. Store secrets outside source control.
# ACCOUNT_PORT=8082
# ACCOUNT_HOST=0.0.0.0
# ACCOUNT_PUBLIC_BASE_URL=http://localhost:8082
# ACCOUNT_ALLOWED_ORIGINS=http://localhost:5173
# ACCOUNT_DATABASE_PATH=./data/emberveil-accounts.sqlite
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# ACCOUNT_CSRF_COOKIE_SECRET=replace-with-at-least-32-random-characters
# ACCOUNT_CSRF_HMAC_KEY=replace-with-at-least-32-random-characters
# ACCOUNT_TRUST_PROXY=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Emberveil <no-reply@example.com>
